# ─── CORE SECURITY & AUTHENTICATION ───
SECRET_KEY=replace_this_with_a_random_jwt_secret_string
INVITE_TOKEN_EXPIRE_DAYS=3

# ─── DATABASE & CACHING (For local terminal runs) ───
# Docker Compose will automatically override these with internal container URLs
MONGODB_URL=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379

# ─── AI CHAT & LLM GATEWAY CONFIGURATION ───
CHAT_MAX_HISTORY_TURNS=10

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.7

# Alternative / Fallback LLM provider keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ─── FRONTEND CLIENT CONFIGURATION ───
# Target addresses for browser HTTP and WebSocket requests
# (Leave as 127.0.0.1 to work perfectly for both local and Docker testing)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
